{
  "name": "next-author-pages",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "node scripts/serve.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test --test-isolation=none tests/*.test.mjs tests/*.test.ts",
    "check": "npm test && npm run typecheck && npm run build",
    "outdated": "vp outdated",
    "upgrade": "npx npm-check-updates@latest -u --reject vite,vite-plus,@vitest/ui && npm install",
    "prebuild": "node scripts/media-kit.mjs",
    "predev": "node scripts/media-kit.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@fontsource-variable/brygada-1918": "^5.3.0",
    "@fontsource-variable/petrona": "^5.3.0",
    "@fontsource/special-elite": "^5.3.0",
    "@tailwindcss/postcss": "4.3.5",
    "jamstacks": "^0.1.2",
    "next": "16.4.6",
    "postcss": "8.5.33",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
